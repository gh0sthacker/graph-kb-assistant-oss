# Copy values into your shell or a private, untracked environment file.
# Do not store real captures, credentials, keys, or tokens in the repository.

# Keep application state outside this checkout.
BB_ASSISTANT_DATA_HOME=

# Optional Caido MCP importer settings. The MCP server must match the pinned
# version and SHA-256 documented in the Caido integration guide.
BB_ASSISTANT_CAIDO_INSTANCE_KEY=
BB_ASSISTANT_CAIDO_MCP_COMMAND=
BB_ASSISTANT_CAIDO_MCP_SHA256=
BB_ASSISTANT_CAIDO_TOKEN_FILE=
BB_ASSISTANT_VAULT_KEY=
CAIDO_URL=http://127.0.0.1:8080
CAIDO_ACCESS_TOKEN=

# Optional KB index and Hermes harness locations.
BB_ASSISTANT_KB_INDEX=
BB_ASSISTANT_HERMES_HOME=
BB_ASSISTANT_HERMES_INSTALL_DIR=

# Leave unset unless you understand the raw-capture access implications.
BB_ASSISTANT_ALLOW_RAW_CAPTURE_TOOL=
